# Copie este arquivo para .env e altere os valores no seu computador.
# Nunca compartilhe seu .env nem utilize senhas de exemplo em produção.

FLASK_SECRET_KEY=substitua_por_uma_chave_aleatoria_gerada_com_secrets
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=substitua_pela_senha_local_do_mysql
MYSQL_DATABASE=sentinela_db

# Configure ao menos a senha do administrador para provisionamento inicial.
# Mínimo de 12 caracteres; contas existentes não serão sobrescritas.
SENTINELA_ADMIN_PASSWORD=
SENTINELA_COORDENACAO_PASSWORD=
SENTINELA_SECRETARIA_PASSWORD=
SENTINELA_PROFESSOR_PASSWORD=
